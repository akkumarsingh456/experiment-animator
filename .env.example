# Public Supabase project configuration (safe to expose in the browser).
# Replace these placeholders with your Supabase project values.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only secrets: configure in Lovable Cloud / hosting secrets, never commit.
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
